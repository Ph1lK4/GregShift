<UserControl x:Class="EML.App.Controls.GtnhResearchHelperPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:EML.App.Services" Style="{StaticResource {x:Type UserControl}}">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/></UserControl.Resources>
 <ScrollViewer x:Name="ToolScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid x:Name="ToolRoot" MinHeight="650" Height="{Binding ActualHeight, ElementName=ToolScroll}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,12">
   <StackPanel>
    <DockPanel LastChildFill="True" Margin="0,0,0,12">
     <WrapPanel DockPanel.Dock="Right">
      <Button Content="重载要素数据" Click="OnRequestData" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
      <Button Content="保存设置" Click="OnSaveSettings" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
      <Button Content="导入设置" Click="OnImportSettings" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
      <Button Content="导出设置" Click="OnExportSettings" Style="{StaticResource QuietButton}" Margin="0,0,0,6"/>
     </WrapPanel>
     <TextBlock Text="神秘时代研究助手" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,6" TextWrapping="Wrap"/>
    </DockPanel>
    <WrapPanel>
     <StackPanel Width="230" Margin="0,0,10,10"><TextBlock Text="起点要素" Margin="0,0,0,6"/>
      <ComboBox ItemsSource="{Binding Aspects}" SelectedItem="{Binding StartAspect}" DisplayMemberPath="Label" Height="40" AutomationProperties.Name="起点要素"/>
     </StackPanel>
     <Button Content="⇄" Command="{Binding SwapEndpointsCommand}" ToolTip="交换起点与终点" AutomationProperties.Name="交换起点与终点" VerticalAlignment="Bottom" Height="40" Margin="0,0,10,10"/>
     <StackPanel Width="230" Margin="0,0,16,10"><TextBlock Text="终点要素" Margin="0,0,0,6"/>
      <ComboBox ItemsSource="{Binding Aspects}" SelectedItem="{Binding EndAspect}" DisplayMemberPath="Label" Height="40" AutomationProperties.Name="终点要素"/>
     </StackPanel>
     <StackPanel Width="130" Margin="0,0,16,10"><TextBlock Text="最少中间要素" Margin="0,0,0,6"/>
      <TextBox Text="{Binding MinimumIntermediateText, UpdateSourceTrigger=PropertyChanged}" Height="40" MaxLength="2" AutomationProperties.Name="最少中间要素数，0至64"/>
     </StackPanel>
     <CheckBox Content="加权模式" IsChecked="{Binding IsWeighted}" VerticalAlignment="Bottom" Margin="0,0,16,21"/>
     <Button Content="计算连接链" Command="{Binding CalculateCommand}" VerticalAlignment="Bottom" Height="40" Margin="0,0,0,10"/>
    </WrapPanel>
    <TextBlock Text="{Binding DataLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardBorder}" Padding="16">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="搜索可用要素（中文 / ID）" Margin="0,0,0,6"/>
      <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="40" MaxLength="80" AutomationProperties.Name="搜索要素中文名或ID" ToolTip="搜索要素中文名或 ID"/>
     </StackPanel>
     <DockPanel Grid.Row="1" Margin="0,0,0,10">
      <WrapPanel DockPanel.Dock="Right"><Button Content="全启用" Command="{Binding EnableAllCommand}" Style="{StaticResource QuietButton}" Padding="8,5"/><Button Content="全禁用" Command="{Binding DisableAllCommand}" Style="{StaticResource QuietButton}" Padding="8,5" Margin="4,0,0,0"/></WrapPanel>
      <TextBlock Text="{Binding AvailableSummary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
     </DockPanel>
     <ListBox x:Name="AspectList" Grid.Row="2" ItemsSource="{Binding VisibleAspects}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
       ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="可用要素及权重">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="8,10"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,10,0"><CheckBox IsChecked="{Binding IsEnabled}" Content="{Binding Label}"/>
         <TextBlock Text="{Binding Components}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="23,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBox Grid.Column="1" Text="{Binding WeightText, UpdateSourceTrigger=PropertyChanged}" MaxLength="24" Height="34" VerticalAlignment="Center" AutomationProperties.Name="{Binding Label}" ToolTip="相对消耗权重，越小越优先（正数）">
         <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsWeighted, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsWeightValid}" Value="False"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
        </TextBox>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="20" services:UiMotion.Enter="True" services:UiMotion.EnterDistance="6">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="连接链" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <TextBlock Grid.Row="1" Text="{Binding ResultSummary}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
     <TextBox Grid.Row="2" Text="{Binding PathText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontSize="16" Padding="14" VerticalScrollBarVisibility="Auto" MinHeight="100" AutomationProperties.Name="计算得到的要素连接链"/>
     <StackPanel Grid.Row="3" Margin="0,16,0,0">
      <WrapPanel Margin="0,0,0,12"><Button Content="复制连接链" Click="OnCopyPath" IsEnabled="{Binding HasResult}" Margin="0,0,8,8"/><Button Content="恢复默认权重" Command="{Binding ResetWeightsCommand}" Style="{StaticResource QuietButton}" Margin="0,0,0,8"/></WrapPanel>
      <TextBlock Text="加权模式以每条连线两端的权重之和计算成本；权重不是你的游戏库存。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
      <TextBlock Text="连接链不考虑研究笔记的障碍格，也不会自动填入游戏。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
  <DockPanel Grid.Row="2">
   <Button DockPanel.Dock="Right" Content="定位无效权重" Click="OnLocateInvalidWeight" Margin="10,8,0,0" VerticalAlignment="Top" Style="{StaticResource QuietButton}" Visibility="{Binding HasInvalidWeights, Converter={StaticResource VisibleWhenTrue}}"/>
   <TextBox Text="{Binding Status, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0,10,0,0"
    MaxHeight="100" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="研究助手状态，可复制">
    <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasInvalidWeights}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBox.Style>
   </TextBox>
  </DockPanel>
 </Grid>
 </ScrollViewer>
</UserControl>
