<UserControl x:Class="EML.App.Controls.GtnhOreRegexPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type UserControl}}">
 <ScrollViewer x:Name="ToolScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid x:Name="ToolRoot" MinHeight="650" Height="{Binding ActualHeight, ElementName=ToolScroll}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,12">
   <StackPanel>
    <DockPanel LastChildFill="True" Margin="0,0,0,12">
     <WrapPanel DockPanel.Dock="Right">
      <Button Content="保存方案" Click="OnSavePlan" IsEnabled="{Binding HasCatalog}" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
      <Button Content="导入方案" Click="OnImportPlan" IsEnabled="{Binding HasCatalog}" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
      <Button Content="导出方案" Click="OnExportPlan" IsEnabled="{Binding HasCatalog}" Style="{StaticResource QuietButton}" Margin="0,0,0,6"/>
     </WrapPanel>
     <TextBlock Text="矿物处理过滤规则" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,6" TextWrapping="Wrap"/>
    </DockPanel>
    <WrapPanel IsEnabled="{Binding HasCatalog}">
     <StackPanel Width="280" Margin="0,0,14,10"><TextBlock Text="通用处理路线" Margin="0,0,0,6"/>
      <ComboBox ItemsSource="{Binding CommonRoutes}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding CommonRouteId}" Height="40" AutomationProperties.Name="通用矿物处理路线"/>
     </StackPanel>
     <StackPanel Width="130" Margin="0,0,14,10"><TextBlock Text="过滤卡字符上限" Margin="0,0,0,6"/>
      <ComboBox ItemsSource="{Binding CharacterLimits}" SelectedItem="{Binding CharacterLimit}" Height="40" AutomationProperties.Name="过滤卡字符上限，2.8版256，2.9版1024"/>
     </StackPanel>
     <CheckBox Content="集成矿石处理厂" IsChecked="{Binding IntegratedFactory}" VerticalAlignment="Bottom" Margin="0,0,14,21"/>
     <Button Content="恢复推荐方案" Command="{Binding ResetPlanCommand}" Style="{StaticResource QuietButton}" VerticalAlignment="Bottom" Height="40" Margin="0,0,0,10"/>
    </WrapPanel>
    <TextBlock Text="2.8 系列通常选择 256 字符，2.9 系列选择 1024 字符。这里只生成规则，不会修改实例。" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding DataStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*" MinWidth="270"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.15*" MinWidth="280"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardBorder}" Padding="16">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="0,0,0,10"><TextBlock Text="搜索矿物（中文 / 英文矿辞）" Margin="0,0,0,6"/>
      <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="40" MaxLength="100" AutomationProperties.Name="中文或英文矿物搜索"/>
      <TextBlock Text="{Binding MaterialSummary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,7,0,0"/>
     </StackPanel>
     <ListBox Grid.Row="1" ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}" DisplayMemberPath="Label" BorderThickness="0" Background="Transparent"
      HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="矿物列表"/>
     <StackPanel Grid.Row="2" Margin="0,12,0,0" IsEnabled="{Binding HasSelection}">
      <TextBlock Text="当前矿物的专用路线" Margin="0,0,0,6"/>
      <ComboBox ItemsSource="{Binding MaterialRoutes}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SelectedRouteId}" Height="40" AutomationProperties.Name="当前矿物专用处理路线"/>
      <TextBlock Text="最终粉末分解" Margin="0,10,0,6"/>
      <ComboBox ItemsSource="{Binding ProcessingChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedProcessingId}" Height="40" AutomationProperties.Name="最终粉末分解方式"/>
      <TextBlock Text="{Binding SelectedMaterialNote}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,9,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Expander Header="地质变种" Margin="0,0,0,12">
      <StackPanel Margin="0,10,0,0">
       <WrapPanel Margin="0,0,0,8"><Button Content="全选" Command="{Binding SelectAllGeologyCommand}" Style="{StaticResource QuietButton}" Padding="8,5"/><Button Content="仅普通矿石" Command="{Binding ClearGeologyCommand}" Style="{StaticResource QuietButton}" Padding="8,5" Margin="6,0,0,0"/></WrapPanel>
       <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Geology}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,14,8"/></DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl></ScrollViewer>
       <TextBlock Text="原始矿石 rawOre 不区分地质。部分勾选时不接收无法区分地质的 variantOre。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0"/>
      </StackPanel>
     </Expander>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Results}">
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
         <StackPanel>
          <DockPanel><Button DockPanel.Dock="Right" Content="复制" Click="OnCopyRule" Tag="{Binding}" Style="{StaticResource QuietButton}" Padding="10,5" Margin="8,0,0,0"/>
           <TextBlock Text="{Binding MachineName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBox Text="{Binding Expression, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Padding="10" MinHeight="56" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,9,0,7" AutomationProperties.Name="矿辞过滤表达式"/>
          <TextBlock Text="{Binding LengthLabel}" FontSize="12">
           <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsOverLimit}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
         </StackPanel>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>
  <TextBox Grid.Row="2" Text="{Binding Status, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0,10,0,0"
   MaxHeight="90" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.Name="矿物过滤规则状态，可复制"/>
 </Grid>
 </ScrollViewer>
</UserControl>
