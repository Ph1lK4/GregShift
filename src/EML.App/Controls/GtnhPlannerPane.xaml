<UserControl x:Class="EML.App.Controls.GtnhPlannerPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:EML.App.Services" Style="{StaticResource {x:Type UserControl}}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,12">
   <StackPanel>
    <DockPanel Margin="0,0,0,12">
     <WrapPanel DockPanel.Dock="Right">
      <CheckBox x:Name="ChineseToggle" Content="中文显示" IsChecked="True" VerticalAlignment="Center" Checked="OnLanguageChanged" Unchecked="OnLanguageChanged" Margin="0,0,12,0"/>
      <Button Content="刷新" Click="OnReload" Style="{StaticResource QuietButton}"/>
      <Button Content="来源与说明" Click="OnAbout" Style="{StaticResource QuietButton}" Margin="6,0,0,0"/>
     </WrapPanel>
     <TextBlock Text="产线规划器" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
    </DockPanel>
    <TextBlock x:Name="SearchGuideTitle" Text="中文物品搜索 · 请在这里输入" Foreground="{DynamicResource AccentTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <WrapPanel>
     <ComboBox x:Name="ItemSearch" IsEditable="True" IsTextSearchEnabled="False" DisplayMemberPath="Label" Width="300" Height="40" MaxDropDownHeight="280"
       TextBoxBase.TextChanged="OnSearchTextChanged" AutomationProperties.Name="中文或英文物品搜索" AutomationProperties.HelpText="中文搜索请使用本框，输入后选择候选物品并点击搜索物品；下方网页搜索框仍使用英文。" ToolTip="中文搜索请在这里输入，再选择候选物品；下方网页搜索框使用英文" Margin="0,0,8,8"/>
     <Button x:Name="SearchButton" Content="搜索物品" Click="OnSearch" Margin="0,0,16,8" Height="40"/>
     <Button x:Name="ImportButton" Content="导入方案" Click="OnImport" Style="{StaticResource QuietButton}" Margin="0,0,8,8" Height="40"/>
     <Button x:Name="ExportButton" Content="导出方案" Click="OnExport" Style="{StaticResource QuietButton}" Margin="0,0,0,8" Height="40"/>
    </WrapPanel>
    <TextBlock x:Name="SearchGuideSteps" Text="输入中文 → 从下拉列表选择物品 → 点“搜索物品”" FontSize="13" TextWrapping="Wrap"/>
    <TextBlock x:Name="SearchGuideBoundary" Text="下方网页内的搜索框仍使用英文，请在上方搜索中文物品。" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
   </StackPanel>
  </Border>
  <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True">
   <Grid>
    <ContentControl x:Name="BrowserHost"/>
    <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Margin="24" VerticalAlignment="Center" MaxWidth="600">
     <TextBlock Text="规划器暂时无法显示" FontSize="21" FontWeight="SemiBold"/>
     <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,12"/>
     <Button Content="重试加载" Click="OnReload" HorizontalAlignment="Left"/>
    </StackPanel>
   </Grid>
  </Border>
  <TextBox Grid.Row="2" x:Name="StatusText" Text="选择产线规划器后才会连接网站。" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0,10,0,0"
   Foreground="{DynamicResource MutedTextBrush}" MinHeight="0" MaxHeight="90" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="规划器操作状态，可复制"/>
 </Grid>
</UserControl>
