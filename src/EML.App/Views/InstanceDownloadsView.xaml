<UserControl x:Class="EML.App.Views.InstanceDownloadsView" Style="{StaticResource {x:Type UserControl}}"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:EML.App.Views"
 xmlns:services="clr-namespace:EML.App.Services" KeyDown="OnPageKeyDown">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <local:OnlineModLabelConverter x:Key="Labels"/>
  <Style x:Key="FilterLabel" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
   <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
 </UserControl.Resources>
 <Grid DataContext="{Binding Downloads}">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <!-- 浏览与详情保留在同一工作区，切换不重建列表，返回后继续原来的滚动位置。 -->
  <Grid x:Name="BrowsePage" IsVisibleChanged="OnBrowseVisibilityChanged">
   <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsDetailOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,18">
    <TextBlock Text="下载实例" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="浏览整合包与官方原版，打开详情后选择版本" Style="{StaticResource PageSubtitle}"/>
   </StackPanel>
   <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="20,16,20,4" Margin="0,0,0,16">
    <StackPanel IsEnabled="{Binding CanBrowse}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,12,0">
       <TextBox x:Name="SearchInput" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" Height="40" Padding="40,8,12,8"
          ToolTip="输入平台上的整合包名称或 Minecraft 版本号；中文关键词由所选平台搜索" AutomationProperties.Name="搜索整合包或原版版本"/>
       <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource MutedTextBrush}"
          HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
       <TextBlock Text="搜索整合包名称或 Minecraft 版本" Foreground="{DynamicResource MutedTextBrush}" Margin="40,0,12,0"
          VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </Grid>
      <Button Grid.Column="1" Content="搜索" Command="{Binding SearchCommand}" Height="40" Padding="22,8"/>
     </Grid>
     <WrapPanel Margin="0,16,0,0">
      <StackPanel Width="210" Margin="0,0,14,12"><TextBlock Text="下载来源" Style="{StaticResource FilterLabel}"/>
       <ComboBox ItemsSource="{Binding Providers}" SelectedIndex="{Binding ProviderIndex}" Height="40" AutomationProperties.Name="实例下载来源"/>
      </StackPanel>
      <WrapPanel Visibility="{Binding IsModpack, Converter={StaticResource Visible}}">
       <StackPanel Width="145" Margin="0,0,14,12"><TextBlock Text="Minecraft 版本（可留空）" Style="{StaticResource FilterLabel}"/>
        <TextBox Text="{Binding GameVersion, UpdateSourceTrigger=PropertyChanged}" Height="40" MaxLength="32" AutomationProperties.Name="整合包游戏版本"/></StackPanel>
       <StackPanel Width="130" Margin="0,0,14,12"><TextBlock Text="加载器" Style="{StaticResource FilterLabel}"/>
        <ComboBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding Loader}" Height="40" AutomationProperties.Name="整合包加载器">
         <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource Labels}, ConverterParameter=Loader}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox></StackPanel>
       <StackPanel Width="150" Margin="0,0,0,12"><TextBlock Text="排序" Style="{StaticResource FilterLabel}"/>
        <ComboBox ItemsSource="{Binding Sorts}" SelectedIndex="{Binding SortIndex}" Height="40" AutomationProperties.Name="整合包排序"/></StackPanel>
      </WrapPanel>
      <CheckBox Content="包含快照 / 预发布版本（可能不稳定）" IsChecked="{Binding IncludeSnapshots}" Margin="0,26,0,12"
         Visibility="{Binding IsMinecraft, Converter={StaticResource Visible}}"/>
     </WrapPanel>
    </StackPanel>
   </Border>
   <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="8,16,8,8">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="12,0,12,12"/>
     <Grid Grid.Row="1">
      <ListBox x:Name="ProjectsList" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" IsEnabled="{Binding CanBrowse}"
         MouseLeftButtonUp="OnProjectMouseUp" PreviewKeyDown="OnProjectKeyDown" AutomationProperties.Name="可下载的整合包和原版"
         HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="12"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate>
        <Grid Margin="0,4">
         <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Border Width="56" Height="56" CornerRadius="10" Background="{DynamicResource RaisedSurfaceBrush}" VerticalAlignment="Top" HorizontalAlignment="Left">
          <Grid><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SecondaryAccentBrush}" FontSize="24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
           <Image Source="{Binding IconPath}" Stretch="Uniform" Width="50" Height="50"/></Grid>
         </Border>
         <StackPanel Grid.Column="1" Margin="0,0,18,0">
          <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,7"><Run Text="{Binding Project.Provider}"/><Run Text=" · "/><Run Text="{Binding Project.Author}"/></TextBlock>
          <TextBlock Text="{Binding DisplaySummary}" TextWrapping="Wrap" MaxHeight="44" LineHeight="22" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
         <Button Grid.Column="2" Content="查看详情  →" Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
            CommandParameter="{Binding}" Style="{StaticResource QuietButton}" VerticalAlignment="Center"/>
        </Grid>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False">
       <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Projects.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
       <TextBlock Text="寻找下一个世界" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
       <TextBlock Text="搜索整合包或版本号，也可以调整来源和筛选。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"/>
      </StackPanel>
     </Grid>
     <Button Grid.Row="2" Content="加载更多结果" Command="{Binding LoadMoreCommand}" Style="{StaticResource QuietButton}" Margin="4,8,4,0" Visibility="{Binding HasMore, Converter={StaticResource Visible}}"/>
    </Grid>
   </Border>
  </Grid>
  <Grid x:Name="DetailsPage" Visibility="{Binding IsDetailOpen, Converter={StaticResource Visible}}" IsVisibleChanged="OnDetailsVisibilityChanged"
     services:UiMotion.Enter="True" services:UiMotion.EnterDistance="6">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,18">
    <Button x:Name="BackToResultsButton" Content="←  返回搜索结果" Command="{Binding BackToResultsCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="-10,0,0,12"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Width="60" Height="60" CornerRadius="12" Background="{DynamicResource RaisedSurfaceBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Grid><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SecondaryAccentBrush}" FontSize="26" VerticalAlignment="Center" HorizontalAlignment="Center"/>
       <Image Source="{Binding SelectedProject.IconPath}" Width="54" Height="54" Stretch="Uniform"/></Grid>
     </Border>
     <StackPanel Grid.Column="1"><TextBlock Text="{Binding SelectedProject.DisplayName}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0"><Run Text="{Binding SelectedProject.Project.Provider}"/><Run Text=" · "/><Run Text="{Binding SelectedProject.Project.Author}"/></TextBlock>
     </StackPanel>
    </Grid>
   </StackPanel>
   <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="24,20">
    <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
     <StackPanel>
      <TextBlock Text="{Binding SelectedProject.DisplaySummary}" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,20"/>
      <TextBlock Text="选择安装版本" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding VersionStatus}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,8,0,12"/>
      <ComboBox ItemsSource="{Binding Releases}" SelectedItem="{Binding SelectedRelease}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanBrowse}" AutomationProperties.Name="整合包或原版发布版本" MinHeight="40"/>
      <Button Content="加载更多版本" Command="{Binding LoadMoreVersionsCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding HasMoreVersions, Converter={StaticResource Visible}}"/>
      <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="10" Padding="16" Margin="0,16,0,0">
       <TextBlock Text="{Binding ReleaseInformation}" TextWrapping="Wrap" LineHeight="23"/>
      </Border>
      <TextBlock Text="下载后确认实例名称，并自动补全所需依赖。Java 和账号可在相应页面设置。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,12,0,0"/>
      <StackPanel Margin="0,28,0,0" Visibility="{Binding IsModpack, Converter={StaticResource Visible}}">
       <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,24"/>
       <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="刷新介绍" Command="{Binding RefreshDescriptionCommand}" Style="{StaticResource QuietButton}" Margin="12,0,0,0"/>
        <TextBlock Text="项目介绍" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
       </DockPanel>
       <TextBlock Text="{Binding DescriptionStatus}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,16"/>
       <TextBox x:Name="ProjectDescriptionText" Text="{Binding ProjectDescription, Mode=OneWay}" IsReadOnly="True"
          TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
          MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0"
          Visibility="{Binding HasProjectDescription, Converter={StaticResource Visible}}" AutomationProperties.Name="平台项目完整介绍"/>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <WrapPanel Grid.Row="2" Margin="0,16,0,0">
    <Button Content="下载并创建实例" Command="{Binding InstallCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,12,0"/>
    <Button Content="查看项目网页" Command="{Binding OpenWebsiteCommand}" Style="{StaticResource QuietButton}"/>
   </WrapPanel>
  </Grid>
  <!-- 安装状态不属于详情页；返回列表时仍可查看进度和取消。 -->
  <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,16,0,0" Visibility="{Binding HasInstallActivity, Converter={StaticResource Visible}}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
     <StackPanel>
      <ProgressBar Value="{Binding ArchivePercent, Mode=OneWay}" Maximum="100" Height="3" Visibility="{Binding IsInstalling, Converter={StaticResource Visible}}"/>
      <TextBlock Text="{Binding ArchiveProgress}" TextWrapping="Wrap" FontSize="12"/>
      <TextBox Text="{Binding InstallStatus, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0"/>
      <StackPanel Visibility="{Binding IsInstalling, Converter={StaticResource Visible}}">
       <ProgressBar Value="{Binding DataContext.Instances.TransferPercent, Mode=OneWay, RelativeSource={RelativeSource AncestorType=UserControl}}" Maximum="100" Height="3" Margin="0,8,0,4"/>
       <TextBlock Text="{Binding DataContext.Instances.TransferStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" TextWrapping="Wrap" FontSize="12"/>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
    <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
     <Button Content="查看安装详情" Command="{Binding OpenDetailsCommand}" CommandParameter="{Binding SelectedProject}" Margin="0,0,8,0">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding IsDetailOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsInstalling}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
     </Button>
     <Button Content="取消下载 / 安装" Command="{Binding InstallCancelCommand}" Visibility="{Binding IsInstalling, Converter={StaticResource Visible}}"/>
    </WrapPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
