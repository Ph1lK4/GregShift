<UserControl x:Class="EML.App.Views.OnlineModsView" Style="{StaticResource {x:Type UserControl}}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EML.App.Views" xmlns:services="clr-namespace:EML.App.Services"
             FontSize="14" KeyDown="OnPageKeyDown">
  <UserControl.Resources>
    <local:OnlineModLabelConverter x:Key="OnlineModLabel"/>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <Style x:Key="FilterLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
      <Setter Property="Padding" Value="18,12"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="0,0,8,0">
          <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><TabPanel IsItemsHost="True"/></Border>
          <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="0,18,0,0"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <!-- 浏览与详情为同一大页面中的两个层级；保留可视树以保存列表滚动与安装选择。 -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="ResultsPage" IsVisibleChanged="OnResultsVisibilityChanged">
      <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsDetailOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource CardBorder}" Padding="20,16">
        <StackPanel IsEnabled="{Binding CanEdit}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0">
              <TextBox x:Name="SearchInput" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" Height="40" Padding="40,8,12,8"
                       ToolTip="支持中文模组名、别名和英文关键词；停止输入后自动搜索" AutomationProperties.Name="搜索模组"/>
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
              <TextBlock Text="搜索模组名称、中文别名或关键词" Foreground="{DynamicResource MutedTextBrush}" Margin="40,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </Grid>
            <Button Grid.Column="1" Content="搜索模组" Command="{Binding SearchCommand}" Height="40"/>
          </Grid>
          <WrapPanel Margin="0,16,0,0">
            <StackPanel Width="148" Margin="0,0,12,8"><TextBlock Text="模组来源" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding Providers}" SelectedIndex="{Binding ProviderIndex}" Height="40" AutomationProperties.Name="模组来源"/></StackPanel>
            <StackPanel Width="110" Margin="0,0,12,8"><TextBlock Text="游戏版本" Style="{StaticResource FilterLabel}"/><TextBox Text="{Binding GameVersion, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" Height="40" ToolTip="留空不限制游戏版本" AutomationProperties.Name="游戏版本"/></StackPanel>
            <StackPanel Width="128" Margin="0,0,12,8"><TextBlock Text="加载器" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding Loader}" Height="40" AutomationProperties.Name="模组加载器"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource OnlineModLabel}, ConverterParameter=Loader}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
            <StackPanel Width="132" Margin="0,0,12,8"><TextBlock Text="排序" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding Sorts}" SelectedIndex="{Binding SortIndex}" Height="40" AutomationProperties.Name="搜索结果排序"/></StackPanel>
          </WrapPanel>
          <Expander Header="更多筛选" Margin="0,2,0,0">
            <WrapPanel Margin="0,10,0,0">
              <StackPanel Width="164" Margin="0,0,12,6"><TextBlock Text="分类" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding Categories}" SelectedIndex="{Binding CategoryIndex}" Height="40" AutomationProperties.Name="模组分类"/></StackPanel>
              <StackPanel Width="164" Margin="0,0,12,6"><TextBlock Text="运行环境" Style="{StaticResource FilterLabel}"/><ComboBox ItemsSource="{Binding Environments}" SelectedIndex="{Binding EnvironmentIndex}" Height="40" AutomationProperties.Name="运行环境" ToolTip="环境筛选目前仅 Modrinth 提供"/></StackPanel>
            </WrapPanel>
          </Expander>
        </StackPanel>
      </Border>
      <DockPanel Grid.Row="1" Margin="2,14,2,10">
        <TextBlock DockPanel.Dock="Right" Text="点击项目查看详情  →" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="16,0,0,0"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
      </DockPanel>
      <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="8">
        <DockPanel>
          <Button DockPanel.Dock="Bottom" Content="加载更多项目" Command="{Binding LoadMoreCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" Margin="4,8,4,0" Visibility="{Binding HasMore, Converter={StaticResource Visible}}"/>
          <Grid>
            <ListBox x:Name="ProjectResults" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" IsEnabled="{Binding CanEdit}"
                     MouseLeftButtonUp="OnProjectClick" PreviewKeyDown="OnProjectKeyDown" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="模组搜索结果">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="14"/></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate>
                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Width="52" Height="52" CornerRadius="10" Background="{DynamicResource RaisedSurfaceBrush}" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <Grid><TextBlock Text="{Binding Placeholder}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryAccentBrush}"/><Image Source="{Binding IconPath}" Width="48" Height="48" Stretch="Uniform"/></Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="0,0,20,0">
                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Caption}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,0,7"/>
                    <TextBlock Text="{Binding DisplaySummary}" ToolTip="{Binding Project.Summary}" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" LineHeight="22"/>
                  </StackPanel>
                  <Button Grid.Column="2" Content="查看详情  →" Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" VerticalAlignment="Center" AutomationProperties.Name="{Binding DisplayName, StringFormat=查看 {0} 的详情}"/>
                </Grid>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" IsHitTestVisible="False">
              <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Projects.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
              <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
              <TextBlock Text="寻找你的下一个模组" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
              <TextBlock Text="输入中文或英文关键词，也可以调整版本和分类。" Foreground="{DynamicResource MutedTextBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="22"/>
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>

    <Grid x:Name="DetailsPage" Visibility="{Binding IsDetailOpen, Converter={StaticResource Visible}}" IsVisibleChanged="OnDetailsVisibilityChanged" services:UiMotion.Enter="True">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,16">
        <Button x:Name="BackButton" DockPanel.Dock="Left" Content="←  返回搜索结果" Command="{Binding BackToResultsCommand}" Style="{StaticResource QuietButton}" Margin="-8,0,16,0"/>
        <TextBlock Text="{Binding TargetText}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </DockPanel>
      <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,12">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="64" Height="64" CornerRadius="12" Background="{DynamicResource RaisedSurfaceBrush}" VerticalAlignment="Top" HorizontalAlignment="Left"><Grid><TextBlock Text="{Binding SelectedProject.Placeholder}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/><Image Source="{Binding SelectedProject.IconPath}" Width="60" Height="60" Stretch="Uniform"/></Grid></Border>
          <StackPanel Grid.Column="1"><TextBlock Text="{Binding SelectedProject.DisplayName}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedProject.Caption}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="{Binding DetailStatus}" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
        </Grid>
      </Border>
      <TabControl x:Name="DetailTabs" Grid.Row="2" services:UiMotion.Enter="True" services:UiMotion.EnterKey="{Binding SelectedIndex, RelativeSource={RelativeSource Self}}">
        <TabItem Header="项目介绍">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel>
              <TextBlock Text="{Binding SelectedProject.DisplaySummary}" TextWrapping="Wrap" LineHeight="24" FontSize="15"/>
              <TextBlock Text="{Binding ProjectSummaryNote}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,6,0,0"/>
              <WrapPanel Margin="0,18,0,20"><Button Content="选择版本与安装" Click="OnChooseVersion" Style="{StaticResource PrimaryButton}" Margin="0,0,12,6"/><Button Content="打开项目主页  ↗" Command="{Binding OpenProjectCommand}" Style="{StaticResource QuietButton}" Margin="0,0,0,6"/></WrapPanel>
              <TextBlock Text="项目信息" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <TextBlock Text="{Binding ProjectInformation}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" LineHeight="22"/>
              <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,22"/>
              <TextBlock Text="完整介绍（原文）" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <TextBox Text="{Binding ProjectDetails.Description, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="80"/>
              <Expander Header="平台原始简介与相关链接" Margin="0,20,0,12"><StackPanel Margin="0,10,0,0"><TextBox Text="{Binding ProjectDetails.Summary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/><TextBlock Text="源码" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"/><TextBox Text="{Binding ProjectDetails.SourceUrl, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/><TextBlock Text="问题反馈" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,0"/><TextBox Text="{Binding ProjectDetails.IssuesUrl, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/></StackPanel></Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="版本与安装">
          <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer x:Name="InstallScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
              <StackPanel>
                <StackPanel IsEnabled="{Binding CanEdit}">
                  <TextBlock Text="选择精确版本" FontSize="16" FontWeight="SemiBold"/>
                  <TextBlock Text="版本和加载器沿用搜索筛选。请核对所选实例的兼容性。" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                  <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Margin="0,0,0,8" AutomationProperties.Name="模组精确版本"><ComboBox.ItemTemplate><DataTemplate><TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding VersionNumber}"/><Run Text=" · "/><Run Text="{Binding Channel, Converter={StaticResource OnlineModLabel}, ConverterParameter=Channel}"/><Run Text=" · "/><Run Text="{Binding Published, StringFormat=yyyy-MM-dd}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                  <Button Content="更多版本" Command="{Binding LoadMoreVersionsCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="-8,0,0,12" Visibility="{Binding HasMoreVersions, Converter={StaticResource Visible}}"/>
                  <TextBlock Text="安装文件" Style="{StaticResource FilterLabel}" Margin="0,6,0,6"/>
                  <ComboBox ItemsSource="{Binding VersionDetails.Files}" SelectedItem="{Binding SelectedFile}" DisplayMemberPath="FileName" ToolTip="一个版本有多个文件时，选择要安装的具体文件" Margin="0,0,0,10" AutomationProperties.Name="模组安装文件"/>
                  <Expander Header="文件大小与校验信息"><TextBox Text="{Binding FileInformation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/></Expander>
                  <Expander Header="版本更新说明（原文）"><TextBox Text="{Binding VersionDetails.Changelog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"/></Expander>
                  <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,20,0,16"><StackPanel><CheckBox Content="自动加入必要依赖" IsChecked="{Binding IncludeRequired}"/><TextBlock Text="关闭后仍可继续安装，但缺少必要依赖可能无法启动。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,8,0,0"/><TextBlock Text="{Binding DependencyInformation}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
                  <Expander Header="可选依赖（默认不安装）" IsExpanded="True" Margin="0,0,0,18"><ItemsControl ItemsSource="{Binding OptionalDependencies}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" Margin="0,6" ToolTip="{Binding Dependency.Description}"><StackPanel><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/><TextBlock Text="{Binding DisplaySummary}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" MaxHeight="44" LineHeight="22" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SummaryNote}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/></StackPanel></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
                </StackPanel>
                <Border x:Name="PlanSection" Tag="{Binding Plan, NotifyOnTargetUpdated=True}" TargetUpdated="OnPlanUpdated" Background="{DynamicResource AccentSoftBrush}" Padding="18" CornerRadius="10" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="PlanHeading" Text="安装清单" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,10"/><TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap"/><TextBox Text="{Binding PlanDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,6,0,0"/><TextBlock Text="更改版本、文件或依赖后需重新生成清单。原包文件不会被自动替换。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,10,0,0"/></StackPanel></Border>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,8,0,0"><StackPanel><TextBlock Text="{Binding InstallStatus}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" MaxHeight="44" TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/><WrapPanel><Button Content="生成安装清单" Command="{Binding PreviewCommand}" Margin="0,0,10,6"/><Button Content="确认下载并安装" Command="{Binding InstallCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,6"/><Button Content="取消解析" Command="{Binding PreviewCancelCommand}" Style="{StaticResource QuietButton}" Margin="0,0,0,6" Visibility="{Binding IsPlanning, Converter={StaticResource Visible}}"/></WrapPanel></StackPanel></Border>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>

    <!-- 已确认的任务独立于详情导航，列表页同样提供进度、可复制结果与取消。 -->
    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,14,0,0" Visibility="{Binding HasInstallActivity, Converter={StaticResource Visible}}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><StackPanel Visibility="{Binding IsInstalling, Converter={StaticResource Visible}}"><ProgressBar Value="{Binding InstallPercent}" Minimum="0" Maximum="100" Height="3" Margin="0,0,0,7"/><TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel><TextBox Text="{Binding InstallStatus, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0" MaxHeight="70" VerticalScrollBarVisibility="Auto"/></StackPanel>
        <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
          <Button Content="查看安装详情" Command="{Binding OpenDetailsCommand}" CommandParameter="{Binding SelectedProject}" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding IsDetailOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsInstalling}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          <Button Content="取消下载" Command="{Binding InstallCancelCommand}" Style="{StaticResource QuietButton}" Visibility="{Binding IsInstalling, Converter={StaticResource Visible}}"/>
        </WrapPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
